# ==================================================
# Log Analyzer Local Infrastructure
# ==================================================

# --------------------------------------------------
# Common
# --------------------------------------------------
LOCAL_BIND_ADDRESS=127.0.0.1
COMPOSE_PROJECT_NAME=log-analyzer-infra

# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------
POSTGRES_IMAGE=postgres:16
POSTGRES_CONTAINER_NAME=log-analyzer-postgres
POSTGRES_DB=log-analyzer-db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin1234
POSTGRES_HOST_PORT=15432
POSTGRES_CONTAINER_PORT=5432

# --------------------------------------------------
# Redis
# --------------------------------------------------
REDIS_IMAGE=redis:7
REDIS_CONTAINER_NAME=log-analyzer-redis
REDIS_HOST_PORT=16379
REDIS_CONTAINER_PORT=6379

# --------------------------------------------------
# Redis Commander
# --------------------------------------------------
REDIS_COMMANDER_IMAGE=rediscommander/redis-commander:latest
REDIS_COMMANDER_CONTAINER_NAME=log-analyzer-redis-commander
REDIS_COMMANDER_HOST_PORT=18081
REDIS_COMMANDER_CONTAINER_PORT=8081

# --------------------------------------------------
# Kafka
# --------------------------------------------------
KAFKA_IMAGE=apache/kafka:3.7.0
KAFKA_CONTAINER_NAME=log-analyzer-kafka

# Host machine access port
KAFKA_HOST_PORT=19092

# Docker network internal ports
KAFKA_INTERNAL_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_EXTERNAL_CONTAINER_PORT=19092

KAFKA_NODE_ID=1
KAFKA_CLUSTER_NAME=local

KAFKA_TOPIC_LOG_EVENTS=log-analyzer.dev.log-events
KAFKA_TOPIC_LOG_EVENTS_DLQ=log-analyzer.dev.log-events-dlq

KAFKA_CLUSTER_ID=LogAnalyzerLocalKafkaCluster01

# --------------------------------------------------
# Kafka UI
# --------------------------------------------------
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:latest
KAFKA_UI_CONTAINER_NAME=log-analyzer-kafka-ui
KAFKA_UI_HOST_PORT=18080
KAFKA_UI_CONTAINER_PORT=8080

# --------------------------------------------------
# OpenSearch
# --------------------------------------------------
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.15.0
OPENSEARCH_CONTAINER_NAME=log-analyzer-opensearch

OPENSEARCH_HOST_PORT=19200
OPENSEARCH_CONTAINER_PORT=9200

OPENSEARCH_PERFORMANCE_ANALYZER_HOST_PORT=19600
OPENSEARCH_PERFORMANCE_ANALYZER_CONTAINER_PORT=9600

OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"
OPENSEARCH_DISCOVERY_TYPE=single-node
OPENSEARCH_DISABLE_SECURITY_PLUGIN=true

# Used only when security plugin is enabled in the future.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=admin1234!

# --------------------------------------------------
# OpenSearch Dashboards
# --------------------------------------------------
OPENSEARCH_DASHBOARDS_IMAGE=opensearchproject/opensearch-dashboards:2.15.0
OPENSEARCH_DASHBOARDS_CONTAINER_NAME=log-analyzer-opensearch-dashboards
OPENSEARCH_DASHBOARDS_HOST_PORT=15601
OPENSEARCH_DASHBOARDS_CONTAINER_PORT=5601
OPENSEARCH_DASHBOARDS_DISABLE_SECURITY_PLUGIN=true
