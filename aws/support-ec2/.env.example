# ==================================================
# Log Analyzer AWS Support EC2 Runtime
# ==================================================

COMPOSE_PROJECT_NAME=log-analyzer-support

# --------------------------------------------------
# Kafka
# --------------------------------------------------
KAFKA_IMAGE=apache/kafka:3.7.0
KAFKA_CONTAINER_NAME=log-analyzer-kafka

KAFKA_INTERNAL_PORT=9092
KAFKA_CONTROLLER_PORT=9093

KAFKA_NODE_ID=1
KAFKA_CLUSTER_NAME=aws-mvp
KAFKA_CLUSTER_ID=LogAnalyzerAwsMvpKafkaCluster01

KAFKA_TOPIC_LOG_EVENTS=log-analyzer.dev.log-events
KAFKA_TOPIC_LOG_EVENTS_DLQ=log-analyzer.dev.log-events-dlq

# Use the Support EC2 private DNS name or private IP for ECS clients.
# Example: ip-10-0-20-10.ap-northeast-2.compute.internal
KAFKA_ADVERTISED_HOST=support-ec2-private-dns-or-ip

# --------------------------------------------------
# Kafka UI
# --------------------------------------------------
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:latest
KAFKA_UI_CONTAINER_NAME=log-analyzer-kafka-ui
KAFKA_UI_CONTAINER_PORT=8080

# --------------------------------------------------
# OpenSearch
# --------------------------------------------------
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.15.0
OPENSEARCH_CONTAINER_NAME=log-analyzer-opensearch

OPENSEARCH_CONTAINER_PORT=9200
OPENSEARCH_PERFORMANCE_ANALYZER_CONTAINER_PORT=9600

OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_DISCOVERY_TYPE=single-node
OPENSEARCH_DISABLE_SECURITY_PLUGIN=true
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me-if-security-enabled

# Used by local/opensearch/init.sh when ENV_FILE points here.
OPENSEARCH_HOST_PORT=9200
OPENSEARCH_SCHEME=http
OPENSEARCH_CLIENT_HOST=localhost

# --------------------------------------------------
# OpenSearch Dashboards
# --------------------------------------------------
OPENSEARCH_DASHBOARDS_IMAGE=opensearchproject/opensearch-dashboards:2.15.0
OPENSEARCH_DASHBOARDS_CONTAINER_NAME=log-analyzer-opensearch-dashboards
OPENSEARCH_DASHBOARDS_CONTAINER_PORT=5601
OPENSEARCH_DASHBOARDS_DISABLE_SECURITY_PLUGIN=true

# --------------------------------------------------
# EBS-backed host paths
# --------------------------------------------------
KAFKA_DATA_PATH=/data/log-analyzer/kafka
OPENSEARCH_DATA_PATH=/data/log-analyzer/opensearch
