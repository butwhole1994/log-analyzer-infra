# Application runtime contract for local, dev, and prod.
# ECS resolves these AWS values through SSM Parameter Store and Secrets Manager;
# do not use this file to store a real password.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=log_analyzer
DB_USERNAME=log_analyzer_app
DB_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_LOG_EVENTS=log-analyzer.local.log-events
KAFKA_TOPIC_LOG_EVENTS_DLQ=log-analyzer.local.log-events-dlq

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_READ_TARGET=log-analyzer-local-logs-read
OPENSEARCH_INDEX_NAME=log-analyzer-local-logs-write
OPENSEARCH_PIPELINE_NAME=log-analyzer-local-logs-pipeline
